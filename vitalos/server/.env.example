# Server Port
PORT=5000

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vitalos?retryWrites=true&w=majority

# Client Allowed Origins (CORS comma-separated list)
CLIENT_URL=http://localhost:5173,https://your-app.netlify.app

# Apple Health Ingestion Webhook / Sync Secret
WEBHOOK_SECRET=your_super_secret_apple_health_sync_token
